<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../build/CalqueContract.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <Target Name="RequireComposerDistribution" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ComposerDistribution)' == '' Or !$([System.IO.Path]::IsPathFullyQualified('$(ComposerDistribution)'))"
      Text="ComposerDistribution must be an explicit absolute directory." />
    <Error Condition="!Exists('$(ComposerDistribution)/Composer.dll')"
      Text="Supply -p:ComposerDistribution=/absolute/path/to/a/built/Composer/distribution. The provider never builds or guesses a sibling compiler checkout." />
    <Error Condition="!Exists('$(ComposerDistribution)/Fidelity.FSharp.Incremental.dll') Or !Exists('$(ComposerDistribution)/Fidelity.FSharp.Incremental.Hosting.dll')"
      Text="The Composer distribution must include its pinned Fidelity.FSharp.Incremental core and Hosting assemblies. Rebuild the reviewed compiler closure before building this provider." />
  </Target>
  <!-- The SDK's dependency-file inputs omit externally selected references.
       A distribution switch must regenerate metadata even when its DLLs are
       older than the previous dependency file. Keep that input explicit. -->
  <Target Name="RecordSelectedWorkerClosure" BeforeTargets="GenerateBuildDependencyFile" DependsOnTargets="ResolveReferences">
    <GetFileHash Files="@(ReferencePath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_SelectedWorkerClosureHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)selected-worker-closure.txt"
      Lines="ComposerDistribution=$(ComposerDistribution);CalqueDistribution=$(CalqueDistribution);@(_SelectedWorkerClosureHash->'%(FullPath)|%(FileHash)')"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <PropertyGroup>
      <MSBuildAllProjects>$(MSBuildAllProjects);$(IntermediateOutputPath)selected-worker-closure.txt</MSBuildAllProjects>
    </PropertyGroup>
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)selected-worker-closure.txt" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Bozzetto.Composer.Protocol/Bozzetto.Composer.Protocol.fsproj" />
    <Reference Include="$(ComposerDistribution)/*.dll" />
    <Compile Include="ProviderContracts.fs" />
    <Compile Include="FormatterSession.fs" />
    <Compile Include="ProviderSession.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="ComposerAdapter.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
