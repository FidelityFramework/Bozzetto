    <ItemGroup>
        <ProjectReference Include="..\Bozzetto.Core\Bozzetto.Core.fsproj" />
        <ProjectReference Include="..\Bozzetto.Simulation\Bozzetto.Simulation.fsproj" />
        <ProjectReference Include="..\Bozzetto\Bozzetto.fsproj" />
        <!-- #141/#142's outcome gate needs a REAL compiled project with no package references (the SDK's
             implicit FSharp.Core — the config every normal user is in, and Bozzetto's own dogfood tests
             never exercise since Bozzetto.Tests.fsproj references Bozzetto.Core). Same
             ReferenceOutputAssembly="false" pattern: built so a session can load it, never linked into
             this test project's own references. -->
        <ProjectReference Include="fixtures\FSharpCoreIdentityFixture\FSharpCoreIdentityFixture.fsproj"
                          PrivateAssets="all"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

  <Target Name="RemoveRetiredFSharpHostOutput" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)host" />
  </Target>
</Project>
