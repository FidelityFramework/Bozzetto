<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../build/ComposerContract.props" />

    <PropertyGroup>
        <FidelityDataProject Condition="'$(FidelityDataProject)' == ''">$(MSBuildThisFileDirectory)../../Fidelity.Data/src/Fidelity.Data/Fidelity.Data.fsproj</FidelityDataProject>
        <!-- Referenced projects outside the solution follow this consumer's
             configuration rather than reverting to their default Debug build. -->
        <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <IsPackable>true</IsPackable>
        <ToolCommandName>boz</ToolCommandName>
        <PackageOutputPath>./nupkg</PackageOutputPath>

        <!-- NuGet config -->
        <PackageId>Bozzetto</PackageId>
        <Authors>Will Ehrendreich</Authors>
        <Description>Bozzetto — interactive development coordination for Clef/Composer and the Fidelity Framework.</Description>
        <Copyright>Copyright © 2025-2026 Will Ehrendreich</Copyright>
        <PackageTags>clef;composer;fidelity;incremental;interactive;mcp;bozzetto</PackageTags>
        <PackageProjectUrl>https://forge.spkez.dev/FidelityFramework/Bozzetto</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://forge.spkez.dev/FidelityFramework/Bozzetto</RepositoryUrl>

        <!-- Share the supported tool payload list with Core and the
             compatibility host. Clear the inherited singular property. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>$(BozzettoTargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bozzetto.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="WorkerProxyWait.fs" />
        <Compile Include="HttpJson.fs" />
        <Compile Include="McpProtocolJson.fs" />
        <Compile Include="DaemonState.fs" />
        <Compile Include="UpdateCheckService.fs" />
        <Compile Include="../bozzetto-web/src/Shared/Protocol.fs" Link="UiBridge/Protocol.fs" />
        <Compile Include="LinuxResources.fs" />
        <Compile Include="ResourceGraph.fs" />
        <Compile Include="ResourceMonitor.fs" />
        <Compile Include="DaemonTelemetry.fs" />
        <Compile Include="ComposerWorkerClient.fs" />
        <Compile Include="ComposerSupervisor.fs" />
        <Compile Include="ComposerClientJson.fs" />
        <Compile Include="TestingPlatformAdapter.fs" />
        <Compile Include="SseEvent.fs" />
        <!-- The daemon's Elm kernel + render stack (moved out of Bozzetto.Core so the
             FSI host closure ships the session engine only). Order is dependency-driven:
             leaves first, BozzettoApp/ElmDaemon last. -->
        <Compile Include="RenderPipeline.fs" />
        <Compile Include="PipelineFlame.fs" />
        <Compile Include="CellGrid.fs" />
        <Compile Include="Theme.fs" />
        <Compile Include="ThemePresets.fs" />
        <Compile Include="SyntaxHighlight.fs" />
        <Compile Include="Draw.fs" />
        <Compile Include="AnsiEmitter.fs" />
        <Compile Include="Editor.fs" />
        <Compile Include="ElmLoop.fs" />
        <Compile Include="SessionDisplay.fs" />
        <Compile Include="TuiEvent.fs" />
        <Compile Include="TestsPane.fs" />
        <Compile Include="BozzettoApp.fs" />
        <Compile Include="BozzettoSseDedup.fs" />
        <Compile Include="BozzettoDispatchReduction.fs" />
        <Compile Include="ElmDaemon.fs" />
        <Compile Include="CohortLandingVerify.fs" />
        <Compile Include="TerminalUI.fs" />
        <Compile Include="JumpToTest.fs" />
        <Compile Include="Screen.fs" />
        <Compile Include="DirectoryConfig.fs" />
        <Compile Include="ConnectionTracker.fs" />
        <!-- Friction storage is daemon-only (moved from Bozzetto.Core so the
             worker process doesn't link Microsoft.Data.Sqlite for nothing). -->
        <Compile Include="FrictionSqlite.fs" />
        <Compile Include="CohortLedger.fs" />
        <Compile Include="LocalData.fs" />
        <Compile Include="CohortGit.fs" />
        <Compile Include="FrictionReviewView.fs" />
        <Compile Include="McpFrictionRecorder.fs" />
        <Compile Include="CohortInspector.fs" />
        <Compile Include="McpPushNotifications.fs" />
        <Compile Include="McpStateHandlers.fs" />
        <Compile Include="SessionPathValidation.fs" />
        <Compile Include="McpAdapter.fs" />
        <Compile Include="DaemonStatusPayload.fs" />
        <Compile Include="McpSessionRouting.fs" />
        <Compile Include="McpRouteError.fs" />
        <Compile Include="CreateSessionUx.fs" />
        <Compile Include="SessionStatusPayload.fs" />
        <Compile Include="Mcp.fs" />


        <Compile Include="McpCohortIntegration.fs" />
        <Compile Include="McpTools.fs" />
        <Compile Include="McpResources.fs" />
        <Compile Include="ComposerTools.fs" />
        <Compile Include="ComposerRoutes.fs" />
        <!-- The browser UI bridge. Protocol.fs is the UI's own vocabulary file,
             compiled here from the same source, never copied. WebAssets.fs is
             generated by bozzetto-web/scripts/weld.js. -->
        <Compile Include="UiBridgeCodec.fs" />
        <Compile Include="WebAssets.fs" />
        <Compile Include="UiBridge.fs" />
        <!-- The page's tab icons (the Clef logo), served from memory by both
             listeners; bozzetto-web/icons holds them, copied from
             clef-lang-site. -->
        <EmbeddedResource Include="../bozzetto-web/icons/favicon.svg" LogicalName="ui/favicon.svg" Link="UiBridge/favicon.svg" />
        <EmbeddedResource Include="../bozzetto-web/icons/favicon-dark.svg" LogicalName="ui/favicon-dark.svg" Link="UiBridge/favicon-dark.svg" />
        <EmbeddedResource Include="../bozzetto-web/icons/favicon.ico" LogicalName="ui/favicon.ico" Link="UiBridge/favicon.ico" />
        <Compile Include="AgentGuidance.fs" />
        <Compile Include="McpServer.fs" />
        <Compile Include="ControlListener.fs" />
        <Compile Include="DaemonMode.fs" />
        <Compile Include="WatchdogRunner.fs" />
        <Compile Include="EnvCheck.fs" />
        <Compile Include="CohortPlay.fs" />
        <Compile Include="McpStdioBridge.fs" />
        <Compile Include="Program.fs" />
        <None Include="..\Readme.md">
          <Pack>true</Pack>
          <PackagePath>/</PackagePath>
          <Link>Readme.md</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Bozzetto.Composer.Protocol/Bozzetto.Composer.Protocol.fsproj" />
        <ProjectReference Include="$(FidelityDataProject)" />
        <ProjectReference Include="..\Bozzetto.Core\Bozzetto.Core.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenTelemetry.Exporter.Console" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />    
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />        
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
        <PackageReference Include="Serilog.Extensions.Logging.File" />
        <PackageReference Include="FSharp.SystemTextJson" />
        <PackageReference Include="FSharp.Data.Adaptive" />
        <PackageReference Include="Fidelity.FSharp.Incremental.Hosting" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <!-- Direct reference to the native SQLite library: pins the transitive
             SQLitePCLRaw.lib.e_sqlite3 to a version bundling SQLite >= 3.50.2,
             resolving CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). The 2.1.x managed
             provider is ABI-compatible with the patched native lib. Lives here
             (not Bozzetto.Core) because friction storage is daemon-only. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\runtimes\win-x64\native\tree-sitter-fsharp.dll"
              Pack="true"
              PackagePath="runtimes\win-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\win-x64\native\tree-sitter-fsharp.dll" />
        <None Include="..\runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib"
              Condition="Exists('..\runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib')"
              Pack="true"
              PackagePath="runtimes\osx-arm64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\osx-arm64\native\libtree-sitter-fsharp.dylib" />
        <None Include="..\runtimes\osx-x64\native\libtree-sitter-fsharp.dylib"
              Condition="Exists('..\runtimes\osx-x64\native\libtree-sitter-fsharp.dylib')"
              Pack="true"
              PackagePath="runtimes\osx-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\osx-x64\native\libtree-sitter-fsharp.dylib" />
        <None Include="..\runtimes\linux-x64\native\libtree-sitter-fsharp.so"
              Condition="Exists('..\runtimes\linux-x64\native\libtree-sitter-fsharp.so')"
              Pack="true"
              PackagePath="runtimes\linux-x64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\linux-x64\native\libtree-sitter-fsharp.so" />
        <None Include="..\runtimes\linux-arm64\native\libtree-sitter-fsharp.so"
              Condition="Exists('..\runtimes\linux-arm64\native\libtree-sitter-fsharp.so')"
              Pack="true"
              PackagePath="runtimes\linux-arm64\native"
              CopyToOutputDirectory="PreserveNewest"
              Link="runtimes\linux-arm64\native\libtree-sitter-fsharp.so" />

        <!-- PackAsTool drops the daemon's own apphost when a referenced project
             also produces one (the pack mis-identifies the host's apphost as
             the tool). Explicitly include the daemon apphost in the payload —
             Bozzetto.exe on Windows, extensionless Bozzetto on Linux/macOS. -->
        <!-- Guarded to the inner build ('$(TargetFramework)' != ''): the outer
             crosstargeting build also evaluates Pack, with $(TargetDir) pointing
             at no real per-TFM output — that phantom path failed NU5019 "File
             not found" once Bozzetto multi-targeted. -->
        <None Include="$(TargetDir)Bozzetto.exe"
              Condition="'$(OS)' == 'Windows_NT' and '$(TargetFramework)' != ''"
              Pack="true"
              PackagePath="tools\$(TargetFramework)\any" />
        <None Include="$(TargetDir)Bozzetto"
              Condition="'$(OS)' != 'Windows_NT' and '$(TargetFramework)' != ''"
              Pack="true"
              PackagePath="tools\$(TargetFramework)\any" />

    </ItemGroup>

  <!-- Remove only generated legacy host output left by an earlier local build. -->
  <Target Name="RemoveRetiredFSharpHostOutput" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <RemoveDir Directories="$(TargetDir)host" />
  </Target>

</Project>
