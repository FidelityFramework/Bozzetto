<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Verified against nuget.org 2026-09-12: Expecto 11.0.0/11.1.0 are now
         stable, so this alpha is stale and should be re-verified/upgraded.
         Originally pinned to the 11.x line for its Expecto.FsCheck 3.x support
         (stable "10.2.3-fscheck3" existed too, but Bozzetto.Tests/Program.fs
         depends on Expecto-11-era API surface — e.g. the args-list-first
         Tests.runTestsWithCLIArgs signature used at Bozzetto.Tests/Program.fs:69,
         121, 190, 206). TODO: reconfirm against stable 11.1.0 and drop the
         prerelease pin. -->
    <PackageVersion Include="Expecto" Version="11.0.0-alpha8" />
    <PackageVersion Include="Expecto.FsCheck" Version="11.0.0-alpha8" />
    <PackageVersion Include="Expecto.Hopac" Version="11.0.0-alpha8" />
    <PackageVersion Include="Falco" Version="5.2.0" />
    <PackageVersion Include="Falco.Datastar" Version="1.3.0" />
    <PackageVersion Include="Falco.Markup" Version="1.4.0" />
    <!-- Only prerelease ever published for the 8.x line (nuget.org tops out at
         8.0.0-beta-003 as of 2026-09-12; there is no stable Fantomas.Core 8.0.0).
         Bozzetto.Core hosts Fantomas.FCS parsing directly (CompilationContext.fs,
         Features/ReloadPlanning.fs) and VariantSelector.fs pins exactly two
         host preprocessing variants users' projects may target — "Fantomas6"
         and "Fantomas8" (Bozzetto.Core/VariantSelector.fs:36-37) — so this pin
         is the newest variant's only available build, not a convenience
         choice. -->
    <PackageVersion Include="Fantomas.Core" Version="8.0.0-alpha-002" />
    <PackageVersion Include="FsCheck" Version="3.3.2" />
    <!-- Retained compiler-service API generation, paired with FSharp.Core.
         These package versions do not select the host SDK or runtime;
         global.json and Directory.Build.props own the stable .NET 10 target.
         Keep nullness checking enabled when validating this API closure. -->
    <PackageVersion Include="FSharp.Compiler.Service" Version="43.13.101-preview7.26381.103" />
    <PackageVersion Include="FSharp.Data.Adaptive" Version="1.2.26" />
    <PackageVersion Include="Fidelity.FSharp.Incremental.Hosting" Version="0.1.0-preview.6" />
    <PackageVersion Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageVersion Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageVersion Include="FuzzySharp" Version="2.0.2" />
    <PackageVersion Include="Ionide.ProjInfo" Version="0.74.1" />
    <PackageVersion Include="Ionide.ProjInfo.FCS" Version="0.74.1" />
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.1" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.0.2" />
    <!-- Official ModelContextProtocol packages from nuget.org. The inherited
         fork bootstrap packed 0.9.0-preview.3, which never supplied these
         1.0.0-rc.1 pins; removing it leaves the resolved package versions and
         lock-file content hashes unchanged. -->
    <PackageVersion Include="ModelContextProtocol" Version="1.0.0-rc.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.0.0-rc.1" />
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="Serilog" Version="4.1.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <!-- Only prerelease track ever published for the 9.x line: the package's
         last numbered stable release was 3.0.1 (as "-dev" prereleases); it
         then jumped straight to unreleased "9.0.0-dev-*" CI builds whose
         dependency closure targets Microsoft.Extensions.* 9.0.0 (confirmed
         via the nuget.org nuspec), matching this repo's
         Microsoft.Extensions.Hosting 9.0.1 pin (~:48) and its `AddFile` call
         at Bozzetto/McpServer.fs:1205. No stable release compatible with
         Microsoft.Extensions.* 9.x exists to fall back to. -->
    <PackageVersion Include="Serilog.Extensions.Logging.File" Version="9.0.0-dev-02303" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.3" />
    <PackageVersion Include="TreeSitter.DotNet" Version="1.3.0" />
    <PackageVersion Include="Verify.Expecto" Version="28.6.1" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.1" />
    <!-- CVE-2025-6965 (GHSA-2m69-gcr7-jv3q): SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11
         bundles SQLite < 3.50.2 (memory corruption, high severity). 2.1.12 is the
         first patched release; Microsoft.Data.Sqlite still resolves the bundle
         to 2.1.11 transitively, so the native lib is pinned directly (see
         Bozzetto.Core.fsproj). -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Raylib-cs" Version="7.0.2" />
    <PackageVersion Include="SageTUI" Version="0.9.4" />
    <PackageVersion Include="Fable.Core" Version="4.5.0" />
    <PackageVersion Include="Fable.Promise" Version="3.2.0" />
    <PackageVersion Include="Fable.Node" Version="1.2.0" />
    <PackageVersion Include="Fable.Browser.Dom" Version="2.16.0" />
    <!-- Paired with the compiler-service API above. FSharp.Core supplies
         netstandard assets; its package major is not a CLR target. -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101-preview7.26359.118" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
    <!-- VS Extension Tests -->
    <PackageVersion Include="xunit" Version="2.4.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.4.5" />
    <PackageVersion Include="FsUnit.xUnit" Version="5.1.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.2" />
  </ItemGroup>
</Project>
