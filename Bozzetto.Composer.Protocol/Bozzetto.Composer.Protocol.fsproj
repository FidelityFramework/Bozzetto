<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../build/ComposerContract.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- The compiler worker loads FSharp.Core 10.1.401. This local central-package
       override does not downgrade the daemon's retained FCS dependency closure. -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" VersionOverride="10.1.401" />
    <Compile Include="ProviderData.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="BAREWireCodec.fs" />
    <Compile Include="StreamFrames.fs" />
    <None Include="WireSchema.txt" />
  </ItemGroup>
</Project>
