#!/usr/bin/env bash
# Build the explicitly selected owned fork, validate/promote its package, then
# regenerate dependency locks. No clone, checkout, source reset, push or publish.
set -euo pipefail

if [[ $# != 1 || "$1" != /* ]]; then
  echo "Usage: scripts/update-harmony /absolute/path/to/Bozzetto.Harmony" >&2
  exit 2
fi
boz_harmony_source=$(realpath "$1")
boz_repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
boz_dotnet=${DOTNET_HOST_PATH:-dotnet}
cd "$boz_repo"
if [[ ! -x "$boz_harmony_source/scripts/pack-bozzetto" ]]; then
  echo "The selected source must contain scripts/pack-bozzetto." >&2
  exit 2
fi
case ${XDG_CACHE_HOME:-} in
  /*) boz_cache=$XDG_CACHE_HOME ;;
  *) boz_cache="$HOME/.cache" ;;
esac
boz_cache=$(realpath -m "$boz_cache")
case "$boz_cache/" in
  "$boz_repo/"*) echo "Harmony build scratch must be outside the Bozzetto checkout." >&2; exit 2 ;;
  "$boz_harmony_source/"*) echo "Harmony build scratch must be outside the Harmony source checkout." >&2; exit 2 ;;
esac
mkdir -p "$boz_cache/bozzetto"
boz_stage=$(mktemp -d "$boz_cache/bozzetto/harmony-refresh.XXXXXX")
echo "Harmony source: $boz_harmony_source"
echo "Package build evidence: $boz_stage"
XDG_CACHE_HOME="$boz_cache" "$boz_harmony_source/scripts/pack-bozzetto" "$boz_stage"
shopt -s nullglob
boz_packages=("$boz_stage"/Bozzetto.Harmony.*.nupkg)
if [[ ${#boz_packages[@]} != 1 ]]; then
  echo "Expected exactly one Bozzetto.Harmony package in $boz_stage." >&2
  exit 1
fi
# Select FSI from the same SDK as the build. This also avoids distro wrappers
# that resolve `dotnet fsi` to an absent fsi.exe and incorrectly exit zero.
boz_sdk_version=$("$boz_dotnet" --version)
boz_fsi=""
while IFS= read -r boz_sdk_line; do
  if [[ "$boz_sdk_line" == "$boz_sdk_version ["*"]" ]]; then
    boz_sdk_base=${boz_sdk_line#"$boz_sdk_version ["}
    boz_sdk_base=${boz_sdk_base%"]"}
    boz_fsi="$boz_sdk_base/$boz_sdk_version/FSharp/fsi.dll"
  fi
done < <("$boz_dotnet" --list-sdks)
if [[ ! -f "$boz_fsi" ]]; then
  echo "The selected .NET SDK must include F# Interactive." >&2
  exit 1
fi
"$boz_dotnet" "$boz_fsi" --exec "$boz_repo/scripts/harmony-package.fsx" -- import "${boz_packages[0]}" "$boz_harmony_source" "$boz_repo"
"$boz_dotnet" restore "$boz_repo/Bozzetto.slnx" --force-evaluate -p:RestoreLockedMode=false
echo "Review vendor/Bozzetto.Harmony and packages.lock.json changes before committing."
