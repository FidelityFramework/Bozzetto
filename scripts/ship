#!/usr/bin/env bash
# scripts/ship [<commit>]   bump the version, gate that commit on this machine,
#                           then push exactly it to Forgejo's existing main.
#
# Pushes the GATED sha, never a moving HEAD: other agents may commit while
# the gate runs, and their commits were not gated. Publish follows from the
# self-hosted "main build" job, which promotes this gate's release bundle.
#
# The bump lives here, not in a commit hook, so an ordinary commit never
# touches Directory.Build.props and parallel worktrees never collide on it.
# One push to main is one release, so one ship is one bump. Pass a commit to
# gate and push something that already carries its bump (a re-run after a fix,
# or a commit made elsewhere); the bump is skipped then, and pre-push still
# refuses anything that doesn't raise the version.
set -euo pipefail
REPO=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
release_ref=refs/heads/main

if [ $# -gt 1 ]; then
  echo "usage: scripts/ship [<commit>]" >&2
  exit 1
fi

# Check the actual destination before changing the version. The inherited
# master target would create a new branch in this Forgejo repository.
remote_head=$(timeout 15 env GIT_TERMINAL_PROMPT=0 git -C "$REPO" \
  ls-remote --exit-code --heads origin "$release_ref") || {
  echo "ship: origin must have an accessible existing main branch." >&2
  exit 1
}
remote_sha=${remote_head%%[[:space:]]*}
"$REPO/scripts/local-gate" --check-inputs

if [ $# -gt 0 ]; then
  sha=$(git -C "$REPO" rev-parse "$1^{commit}")
else
  if [ -n "$(git -C "$REPO" status --porcelain -- Directory.Build.props bozzetto-vscode/package.json)" ]; then
    echo "ship: Directory.Build.props or bozzetto-vscode/package.json has uncommitted changes." >&2
    echo "      commit or revert them first, so the bump lands on a clean version." >&2
    exit 1
  fi
  version=$("$REPO/scripts/bump-version")
  git -C "$REPO" commit --quiet --no-verify \
    -m "chore: release v$version" \
    -- Directory.Build.props bozzetto-vscode/package.json
  echo "ship: bumped to $version"
  sha=$(git -C "$REPO" rev-parse HEAD)
fi

"$REPO/scripts/local-gate" "$sha"
# The checkout need not have installed the hook yet. Apply its checks here too.
printf '%s %s %s %s\n' HEAD "$sha" "$release_ref" "$remote_sha" \
  | "$REPO/scripts/pre-push"
git -C "$REPO" push origin "$sha:$release_ref"
echo "ship: pushed ${sha:0:8} to origin/main; the gated bundle is available locally"
