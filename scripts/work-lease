#!/usr/bin/env bash
# Bounded HTTP control and command ownership for leased build and test work.
# work-lease acquire <kind> <holder> | renew <id> <holder> | withdraw <kind> <holder> | release <id> | run <kind> <command>...
# Optional display labels: BOZZETTO_AGENT and BOZZETTO_PROJECT (default: cwd).
# Labels are caller-reported context, not authenticated identity or test proof.
set -euo pipefail
endpoint="http://127.0.0.1:${BOZZETTO_MCP_PORT:-47749}/api/lease"

acquire() {
  local kind=$1 holder=$2 request reply decision
  case "$kind" in full_build|test_suite_run) ;; *) echo "work-lease: unsupported kind $kind" >&2; return 64 ;; esac
  request=$(jq -cn --arg kind "$kind" --arg holder "$holder" '{kind:$kind,holder:$holder}')
  reply=$(curl --silent --show-error --fail --connect-timeout 1 --max-time 5 \
    -H 'Content-Type: application/json' --data "$request" "$endpoint/request") || return 69
  decision=$(jq -er '.decision' <<<"$reply") || return 69
  case "$decision" in
    granted) jq -ce 'select(.success == true) | select(.leaseId | type == "string" and length > 0) | select(.expiresAt | type == "string")' <<<"$reply" ;;
    wait) echo "work-lease: deferred: $reply" >&2; return 75 ;;
    refused) echo "work-lease: refused: $reply" >&2; return 69 ;;
    *) echo "work-lease: invalid admission response" >&2; return 69 ;;
  esac
}

withdraw() {
  local request
  request=$(jq -cn --arg kind "$1" --arg holder "$2" '{kind:$kind,holder:$holder}')
  curl --silent --show-error --fail --connect-timeout 1 --max-time 5 \
    -H 'Content-Type: application/json' --data "$request" "$endpoint/withdraw" \
    | jq -ce 'select(.success == true)'
}

renew() {
  # 0 renewed | 1 the daemon reports the lease gone | 66 no renewal route (older
  # daemon; the TTL governs) | 69 unreachable or malformed reply.
  local request reply code body
  request=$(jq -cn --arg leaseId "$1" --arg holder "$2" '{leaseId:$leaseId,holder:$holder}')
  reply=$(curl --silent --show-error --connect-timeout 1 --max-time 5 -w '\n%{http_code}' \
    -H 'Content-Type: application/json' --data "$request" "$endpoint/renew") || return 69
  code=${reply##*$'\n'}; body=${reply%$'\n'*}
  case "$code" in
    200) ;;
    404) echo "work-lease: the daemon serves no lease renewal (install a current daemon); this lease runs on its TTL" >&2; return 66 ;;
    *) return 69 ;;
  esac
  jq -e '.success == true' <<<"$body" >/dev/null || return 69
  case "$(jq -r '.outcome' <<<"$body")" in
    renewed) jq -ce 'select(.expiresAt | type == "string")' <<<"$body" || return 69 ;;
    already_gone) return 1 ;;
    *) return 69 ;;
  esac
}

release() {
  local request
  request=$(jq -cn --arg leaseId "$1" '{leaseId:$leaseId}')
  curl --silent --show-error --fail --connect-timeout 1 --max-time 5 \
    -H 'Content-Type: application/json' --data "$request" "$endpoint/release" \
    | jq -ce 'select(.success == true)'
}

case "${1:-}" in
  acquire) [ "$#" = 3 ] || exit 64; acquire "$2" "$3" ;;
  renew) [ "$#" = 3 ] || exit 64; renew "$2" "$3" ;;
  withdraw) [ "$#" = 3 ] || exit 64; withdraw "$2" "$3" ;;
  release) [ "$#" = 2 ] || exit 64; release "$2" ;;
  run)
    [ "$#" -ge 3 ] || exit 64
    kind=$2
    shift 2
    # One stable holder per agent and project: a retry after Wait is the SAME
    # queued ask to the pool, not a second claim behind the first. The gate
    # suffix made every attempt a new holder and left ghosts in the queue.
    holder="${BOZZETTO_AGENT:-caller} · ${BOZZETTO_PROJECT:-$PWD}"
    # A deferred ask (exit 75) stays in the pool's line: the same holder's retry
    # is the same ask, and an ask nobody retries within two minutes is reaped.
    # Only a caller that gives up withdraws, with `work-lease withdraw`.
    rc=0; reply=$(acquire "$kind" "$holder") || rc=$?
    case $rc in
      0) ;;
      75) exit 75 ;;
      *) exit 69 ;;
    esac
    lease_id=$(jq -er '.leaseId' <<<"$reply")
    child=""
    cleanup() {
      local status=$?
      trap - EXIT INT TERM
      if [ -n "$child" ] && kill -0 "$child" 2>/dev/null; then
        kill -TERM -- "-$child" 2>/dev/null || kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
      fi
      if ! release "$lease_id" >/dev/null; then
        echo "work-lease: release failed for owned lease $lease_id" >&2
        [ "$status" -ne 0 ] || status=69
      fi
      exit "$status"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    expires=$(date -d "$(jq -er '.expiresAt' <<<"$reply")" +%s)
    if [ "$expires" -le $(( $(date +%s) + 60 )) ]; then echo "work-lease: granted lease has insufficient remaining time" >&2; exit 75; fi
    "$@" &
    child=$!
    # A live run renews on a heartbeat inside the lease's lifetime; the TTL
    # bounds an abandoned lease, not a running one. Only the daemon's own word
    # that the lease is gone (expired or restarted) stops the work; an older
    # daemon without the route leaves the TTL in charge, and an unreachable
    # daemon is retried, since it will answer "gone" once it is back.
    heartbeat() {
      local interval=$(( (expires - $(date +%s)) / 3 )) renewed rc
      [ "$interval" -ge 30 ] || interval=30
      while kill -0 "$child" 2>/dev/null; do
        sleep "$interval"
        kill -0 "$child" 2>/dev/null || break
        rc=0; renewed=$(renew "$lease_id" "$holder") || rc=$?
        case "$rc" in
          0) expires=$(date -d "$(jq -er '.expiresAt' <<<"$renewed")" +%s)
             interval=$(( (expires - $(date +%s)) / 3 ))
             [ "$interval" -ge 30 ] || interval=30 ;;
          1) echo "work-lease: lease $lease_id is gone; stopping unleased work" >&2; kill -TERM "$child" 2>/dev/null; return 1 ;;
          66) return 0 ;;
          *) echo "work-lease: renewal unreachable; retrying in ${interval}s" >&2 ;;
        esac
      done
    }
    heartbeat &
    beat=$!
    status=0
    wait "$child" || status=$?
    child=""
    kill "$beat" 2>/dev/null; wait "$beat" 2>/dev/null || true
    exit "$status"
    ;;
  *) echo "usage: work-lease acquire <kind> <holder> | renew <id> <holder> | withdraw <kind> <holder> | release <id> | run <kind> <command>..." >&2; exit 64 ;;
esac
