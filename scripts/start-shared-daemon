#!/usr/bin/env bash
# Launch the reviewed daemon from dedicated external workspace/state directories.
set -euo pipefail
set +m

fail() { printf '%s\n' "$*" >&2; exit 1; }
for command in curl jq realpath dirname timeout setsid; do
  command -v "$command" >/dev/null || fail "Required launcher command is unavailable: $command"
done

identity_url=http://127.0.0.1:47750/api/daemon-info
health_url=http://127.0.0.1:47749/health
composer_url=http://127.0.0.1:47749/api/composer/sessions

get_json() {
  curl --silent --fail --connect-timeout 0.5 --max-time 3 "$1" | jq -ce .
}

occupied=()
for port in 47749 47750; do
  if timeout 0.5 bash -c 'exec 3<>"/dev/tcp/127.0.0.1/$1"' _ "$port" 2>/dev/null; then
    occupied+=("$port")
  fi
done
if (( ${#occupied[@]} > 0 )); then
  identity=null
  if answer=$(get_json "$identity_url"); then identity=$answer; fi
  ports=$(printf '%s\n' "${occupied[@]}" | jq -s .)
  jq -n --argjson ports "$ports" --argjson identity "$identity" \
    --arg health "$health_url" --arg composer "$composer_url" \
    '{action:"preserved existing listener",ports:$ports,identity:$identity,
      readinessChecked:false,nextChecks:[$health,$composer]}'
  [[ ${#occupied[@]} == 2 && $identity != null ]]
  exit
fi

script_path=$(realpath -- "${BASH_SOURCE[0]}")
repository_parent=$(dirname -- "$(dirname -- "$(dirname -- "$script_path")")")
external_root() {
  local variable=$1 default_root=$2 configured resolved
  configured=${!variable-}
  if [[ -z $configured ]]; then configured=$default_root; fi
  [[ $configured == /* ]] || fail "$variable must be an absolute path: $configured"
  resolved=$(realpath -m -- "$configured/bozzetto")
  case "$resolved" in
    "$repository_parent"|"$repository_parent"/*)
      fail "$variable must place Bozzetto data outside $repository_parent" ;;
  esac
  printf '%s\n' "$resolved"
}

launcher=${BOZZETTO_BIN:-}
if [[ -z $launcher ]]; then launcher=$(command -v boz || true); fi
[[ -n $launcher ]] || fail 'Install the reviewed boz launcher first; see the live checkpoint.'
launcher=$(realpath -e -- "$launcher") || fail "Reviewed boz launcher does not exist: $launcher"
[[ -x $launcher && -f $launcher ]] || fail "Reviewed boz launcher is not executable: $launcher"
workspace=$(external_root XDG_DATA_HOME "$HOME/.local/share")/workspace
state=$(external_root XDG_STATE_HOME "$HOME/.local/state")
log=$state/daemon.log
pid_file=$state/daemon.pid
for path in "$workspace" "$log" "$pid_file"; do
  [[ ! -L $path ]] || fail "Refusing redirected daemon workspace/state path: $path"
done
mkdir -p -- "$workspace" "$state"
# Job control stays off: setsid execs in this child's PID, which identity must report.
(cd -- "$workspace" && exec setsid -- "$launcher" --no-resume) </dev/null >>"$log" 2>&1 &
daemon_pid=$!
printf '%s\n' "$daemon_pid" > "$pid_file"
deadline=$((SECONDS + 20))
while (( SECONDS < deadline )); do
  if ! kill -0 "$daemon_pid" 2>/dev/null; then
    status=0
    wait "$daemon_pid" || status=$?
    fail "Daemon exited $status; inspect $log"
  fi
  if identity=$(get_json "$identity_url"); then
    jq -e --argjson pid "$daemon_pid" '.pid == $pid' <<<"$identity" >/dev/null \
      || fail 'Port ownership changed during startup; inspect daemon identity.'
    if health=$(get_json "$health_url") && composer=$(get_json "$composer_url"); then
      jq -n --argjson identity "$identity" --argjson health "$health" \
        --argjson composer "$composer" --arg log "$log" \
        '{identity:$identity,health:$health,readinessChecked:true,
          composerConfigured:$composer.configured,log:$log}'
      jq -e --argjson composer "$composer" \
        '.healthy == true and ((.componentFailures // []) | length == 0) and $composer.configured == true' \
        <<<"$health" >/dev/null
      exit
    fi
  fi
  sleep 0.2
done
fail "No readiness response within 20 seconds; inspect PID $daemon_pid and $log"
