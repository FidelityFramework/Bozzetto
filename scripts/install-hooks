#!/usr/bin/env bash
set -euo pipefail

repo=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
configured=$(git -C "$repo" config --get core.hooksPath || true)
if [ -n "$configured" ]; then
  echo "install-hooks: core.hooksPath is already configured ($configured); preserve it and chain scripts/pre-push there." >&2
  exit 1
fi

hook=$(git -C "$repo" rev-parse --path-format=absolute --git-path hooks/pre-push)
if [ -e "$hook" ] || [ -L "$hook" ]; then
  if [ "$(realpath -- "$hook")" = "$repo/scripts/pre-push" ]; then
    echo "pre-push hook already installed."
    exit 0
  fi
  echo "install-hooks: preserving existing $hook; chain scripts/pre-push before replacing it." >&2
  exit 1
fi

mkdir -p -- "$(dirname "$hook")"
ln -s -- "$repo/scripts/pre-push" "$hook"
echo "Installed pre-push release checks for this checkout. Integration-branch recovery pushes remain available."
